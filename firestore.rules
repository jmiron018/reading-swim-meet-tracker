rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Final meet records. Anyone can read (for reporting); only accounts on
    // the scorekeeper list can write, and only well-formed records.
    match /meets/{meetId} {
      allow read: if true;
      allow create, update: if isScorekeeper() && validMeet(request.resource.data);
      allow delete: if isScorekeeper();
    }

    // Usage counter: one record per phone (random ID), holding only the
    // scorer's name and first/last-seen times. Anyone can read (shown on the
    // Results tab); a phone can create its record and then only move lastSeen
    // forward or change the name. No deletes.
    match /devices/{id} {
      allow read: if true;
      allow create: if id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['name', 'firstSeen', 'lastSeen'])
        && validName(request.resource.data.name)
        && request.resource.data.firstSeen == request.time
        && request.resource.data.lastSeen == request.time;
      allow update: if request.resource.data.keys().hasOnly(['name', 'firstSeen', 'lastSeen'])
        && validName(request.resource.data.name)
        && request.resource.data.firstSeen == resource.data.firstSeen
        && request.resource.data.lastSeen == request.time;
    }

    function validName(n) {
      return n is string && n.size() <= 40;
    }

    // Scorekeeper list: one document per allowed account, with the account's
    // email (lowercase) or UID as the document ID. Managed in the Firebase
    // console only.
    match /Scorekeepers/{id} {
      allow read, write: if false;
    }

    function isScorekeeper() {
      return request.auth != null
        && (exists(/databases/$(database)/documents/Scorekeepers/$(request.auth.token.email))
          || exists(/databases/$(database)/documents/Scorekeepers/$(request.auth.uid)));
    }

    function validMeet(d) {
      return d.keys().hasAll(['date', 'opponent', 'us', 'them', 'races', 'submittedAt', 'submittedBy'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.opponent is string && d.opponent.size() > 0 && d.opponent.size() <= 60
        && d.us is number && d.them is number
        && d.races is list && d.races.size() == 12
        && d.submittedAt == request.time
        && d.submittedBy == request.auth.token.email;
    }
  }

  // Everything else is closed.
}
